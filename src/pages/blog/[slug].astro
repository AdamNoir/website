---
import type { GetStaticPaths } from 'astro';
import Navbar from '../../components/Navbar.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export const getStaticPaths = (async () => {
  const blogPost = await getCollection('blog');
  return blogPost.map((post) => {
    return {
      params: { slug: post.id },
      props: { post: post },
    };
  });
}) satisfies GetStaticPaths;
const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<BaseLayout title="Post Title">
  <Navbar />
  <main class="post-main">
    <aside class="toc">
      <span class="toc-label">Table of content</span>
      <p>
        {
          headings.map((h) => (
            <a href={`#${h.slug}`} class="toc-link">
              {h.text}
            </a>
          ))
        }
      </p>
    </aside>

    <article class="post-content">
      <h1 class="post-title-content">{post.data.title}</h1>
      <p class="post-subtitle-content">{post.data.description}</p>
      <hr class="post-divider" />

      <div class="post-body">
        <Content />
      </div>
    </article>
  </main>
  <script>
    // ── TOC colapsable en móvil ──
    const toggleBtn = document.getElementById('toc-toggle');
    const tocNav = document.getElementById('toc-nav');

    toggleBtn?.addEventListener('click', () => {
      const isOpen = tocNav?.classList.toggle('open');
      toggleBtn.classList.toggle('open', isOpen);
      toggleBtn.setAttribute('aria-expanded', String(isOpen));
    });

    // Cerrar al navegar (móvil)
    tocNav?.querySelectorAll('.toc-link').forEach((link) => {
      link.addEventListener('click', () => {
        if (window.innerWidth <= 768) {
          tocNav.classList.remove('open');
          toggleBtn?.classList.remove('open');
          toggleBtn?.setAttribute('aria-expanded', 'false');
        }
      });
    });

    // ── Active link al hacer scroll ──
    const headingEls = document.querySelectorAll('.post-body h2[id]');
    const tocLinks = document.querySelectorAll('.toc-link');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            tocLinks.forEach((l) => l.classList.remove('active'));
            document
              .querySelector(`.toc-link[href="#${entry.target.id}"]`)
              ?.classList.add('active');
          }
        });
      },
      { rootMargin: '-15% 0px -75% 0px' },
    );

    headingEls.forEach((el) => observer.observe(el));
  </script>
</BaseLayout>
