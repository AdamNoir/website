---
import Navbar from '../components/Navbar.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Projects">
  <Navbar />
  <section class="page active" id="projects">
    <div class="projects-inner">
      <h2>Projects</h2>

      <div class="projects-grid">
        <ProjectCard
          name="Portfolio Website"
          ,
          description="A minimalist portfolio developed with Astro and pure CSS, powered by the PNPM package manager."
          ,
          tags={['AstroJS', 'CSS']}
          ,
          liveUrl="https://benevolent-jalebi-319ca3.netlify.app"
          ,
          sourceCodeUrl="https://github.com/AdamNoir/website.git"
        />
      </div>
    </div>
  </section>
</BaseLayout>
