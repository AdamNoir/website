---
import Navbar from '../components/Navbar.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Projects">
  <Navbar />
  <section class="page active" id="projects">
    <div class="projects-inner">
      <h2>Projects</h2>

      <div class="projects-grid">
        <ProjectCard
          name="REST API"
          ,
          description="API RESTful para gestión de usuarios con autenticación JWT, rate
            limiting y documentación con Swagger."
          ,
          tags={[
            'NestJS',
            'MongoDB',
            'MongoDB',
            'MongoDB',
            'MongoDB',
            'MongoDB',
          ]}
          ,
          liveUrl="https://www.google.com"
          ,
          sourceCodeUrl="www.facebook.com"
        />

        <ProjectCard
          name="Dashboard"
          ,
          description="Panel de administración con gráficas en tiempo real, filtros
              dinámicos y exportación de reportes en CSV."
          ,
          tags={['Angular', 'SQL']}
          ,
          liveUrl="https://www.google.com"
          ,
          sourceCodeUrl="www.facebook.com"
        />

        <ProjectCard
          name="Machine Learning"
          ,
          description="Modelo de clasificación de imágenes entrenado con TensorFlow para
              identificar objetos en tiempo real."
          ,
          tags={['Python', 'TensorFlow']}
          ,
          liveUrl="https://www.google.com"
          ,
          sourceCodeUrl="www.facebook.com"
        />

        <!-- Agrega más cards aquí siguiendo el mismo patrón -->
      </div>
    </div>
  </section>
</BaseLayout>
